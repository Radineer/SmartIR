# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ir_insight

# OpenAI API
OPENAI_API_KEY=your_openai_api_key

# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=ap-northeast-1

# S3 Bucket
S3_BUCKET_NAME=ir-insight-storage

# JWT Settings
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External APIs
TDNET_API_URL=https://www.tdnet.info/api/v1/
EDINET_API_URL=https://disclosure.edinet-fsa.go.jp/api/v1/

# Application Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:3000

# TTS Engine ("aivisspeech" or "voicevox")
TTS_ENGINE=aivisspeech
VOICEVOX_HOST=http://localhost:50021
AIVISSPEECH_HOST=http://localhost:10101
TTS_SPEAKER_ID=1878365376

# YouTube API (OAuth2)
YOUTUBE_CLIENT_ID=your_client_id
YOUTUBE_CLIENT_SECRET=your_client_secret

# OBS WebSocket
OBS_WS_PASSWORD=

# J-Quants API (日本取引所グループ公式API)
JQUANTS_MAIL_ADDRESS=your_email
JQUANTS_PASSWORD=your_password

# Notification Settings (ウォッチリストアラート通知)
# SendGrid (メール通知)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@smartir.jp

# AWS SES (メール通知 - SendGridの代替)
SES_FROM_EMAIL=noreply@smartir.jp

# Slack (Webhook通知)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Gemini API
GOOGLE_API_KEY=your_google_api_key

# EDINET API
EDINET_API_KEY=your_edinet_api_key

# Talking Avatar Services
DID_API_KEY=your_did_api_key
HEYGEN_API_KEY=your_heygen_api_key
HEDRA_API_KEY=your_hedra_api_key

# Social Media - Twitter/X
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Social Media - TikTok
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# Social Media - Instagram
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_USER_ID=your_instagram_user_id

# note.com Publishing
NOTE_EMAIL=your_note_email
NOTE_PASSWORD=your_note_password

# Auto Publishing Flags
PUBLISH_AUTO_NOTE=false
PUBLISH_AUTO_TWEET=false

# Output Directories (optional, defaults to ./static/*)
# VIDEO_OUTPUT_DIR=./static/videos
# AUDIO_OUTPUT_DIR=./static/audio
# SHORT_VIDEO_OUTPUT_DIR=./static/shorts
# THUMBNAIL_OUTPUT_DIR=./static/thumbnails